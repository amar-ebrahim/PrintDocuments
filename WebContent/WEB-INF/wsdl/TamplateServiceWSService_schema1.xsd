<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://innsys.com/" version="1.0" xmlns:tns="http://innsys.com/">

  <xs:element name="Exception" type="tns:Exception"/>

  <xs:element name="fillPdfAndStore" type="tns:fillPdfAndStore"/>

  <xs:element name="fillPdfAndStoreResponse" type="tns:fillPdfAndStoreResponse"/>

  <xs:element name="keyValuePair" type="tns:KeyValuePair"/>

  <xs:complexType name="fillPdfAndStore">
    <xs:sequence>
      <xs:element minOccurs="0" name="documentId" type="xs:string"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="inputValues" nillable="true" type="tns:KeyValuePair"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="KeyValuePair">
    <xs:sequence>
      <xs:element name="key" type="xs:string"/>
      <xs:element name="value" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="fillPdfAndStoreResponse">
    <xs:sequence>
      <xs:element minOccurs="0" name="return" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Exception">
    <xs:sequence>
      <xs:element minOccurs="0" name="message" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>