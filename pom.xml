<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.innsys</groupId>
    <artifactId>PrintDocuments</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <!-- ================================================================
         Source layout keeps the existing Eclipse project structure:
           src/       -> Java sources
           resources/ -> config.properties + font file
    ================================================================ -->
    <build>
        <sourceDirectory>src</sourceDirectory>

        <resources>
            <resource>
                <directory>resources</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                    <excludes>
                        <!-- Old SOAP/WAR entry point — replaced by PrintDocumentsService -->
                        <exclude>com/innsys/TamplateServiceWSDelegate.java</exclude>
                        <!-- FileNet integration moved to BAW ECM activities -->
                        <exclude>com/innsys/FileNetCS.java</exclude>
                        <exclude>com/innsys/ConfigProps.java</exclude>
                        <!-- Scratch file -->
                        <exclude>com/innsys/test.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Shaded (uber) JAR: bundles PDFBox + ICU4J into one file.
                 Jace.jar is "provided" scope so it is NOT bundled — it lives
                 on the BAW / WebSphere server already. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <filters>
                                <!-- Strip digital signatures that break shading -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- Merge SPI service descriptors (required for PDFBox font parsers) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.innsys.PrintDocumentsService</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- ── PDF processing ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.35</version>
        </dependency>
        <!-- fontbox is a transitive dep of pdfbox but listed explicitly
             to ensure the correct version is resolved -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>fontbox</artifactId>
            <version>2.0.35</version>
        </dependency>
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- ── Arabic shaping ─────────────────────────────────────────── -->
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>74.1</version>
        </dependency>

        <!-- ── FileNet JACE API — NOT shaded in; already on BAW server ── -->
        <!-- Install once to local repo with:
             mvn install:install-file \
               -Dfile=WebContent/WEB-INF/lib/Jace.jar \
               -DgroupId=com.filenet -DartifactId=jace \
               -Dversion=5.5.0 -Dpackaging=jar
             Then change scope to "provided". -->
        <!-- Jace.jar removed: FileNet operations are now handled by BAW ECM
             integration activities, not by this JAR. -->
    </dependencies>
</project>
